# SMTP receiver environment — copy to smtp-receiver/.env on the VPS

SMTP_PORT=25
SMTP_HOSTNAME=mail.pisairtel.com
ALLOWED_DOMAINS=pisairtel.com
INBOUND_URL=http://127.0.0.1:3020/api/inbound-email

# Must match the mail server's INBOUND_EMAIL_SECRET
INBOUND_EMAIL_SECRET=

# Optional STARTTLS (recommended once certs exist):
# TLS_KEY=/etc/letsencrypt/live/mail.pisairtel.com/privkey.pem
# TLS_CERT=/etc/letsencrypt/live/mail.pisairtel.com/fullchain.pem
