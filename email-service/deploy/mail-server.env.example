# Mail server environment — copy to server/.env on the VPS
# Generate secrets: openssl rand -hex 32

PORT=3020

JWT_SECRET=
ADMIN_SECRET=
INBOUND_EMAIL_SECRET=

# Outbound: the tenant's own Brevo account
BREVO_API_KEY=
# Optional: if Brevo delivery webhooks are configured
BREVO_WEBHOOK_SECRET=

# Branding / deployment
APP_BASE_URL=https://mail.pisairtel.com
BRAND_NAME=Pis Airtel Mail
BRAND_COLOR=#F2782E
MAIL_SENDER_NAME=Pis Airtel Mail
MAIL_SENDER_EMAIL=hello@pisairtel.com
ALLOWED_ORIGINS=https://mail.pisairtel.com,https://pisairtel.com,https://www.pisairtel.com

# ── Malware scanning (ClamAV) ──────────────────────────────────────────────
# Attachments are scanned via clamd's INSTREAM protocol on upload, send, and
# inbound delivery; infected files are quarantined and refused at download.
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
#CLAMAV_HOST=127.0.0.1
#CLAMAV_PORT=3310
# Set to 1 to reject files when clamd is unreachable (default: allow + log)
#CLAMAV_REQUIRED=0
# Set to 0 to disable scanning entirely
#AV_SCAN=1
